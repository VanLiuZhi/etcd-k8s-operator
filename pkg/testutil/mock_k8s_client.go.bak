// MockK8sClient 模拟K8s客户端，用于测试调谐过程
type MockK8sClient struct {
	mu sync.RWMutex

	// 存储K8s资源
	Pods     map[string]*corev1.Pod
	Services map[string]*corev1.Service
	PVCs     map[string]*corev1.PersistentVolumeClaim

	// 模拟配置
	StateChangeDelay  time.Duration
	CreatePodFail     bool
	DeletePodFail     bool
	CreateServiceFail bool
	CreatePVCFail     bool

	// 事件记录
	EventRecords []EventRecord
}

// EventRecord 记录K8s事件
type EventRecord struct {
	EventType string
	Reason    string
	Message   string
	Timestamp time.Time
}

// NewMockK8sClient 创建新的Mock K8s客户端
func NewMockK8sClient() *MockK8sClient {
	return &MockK8sClient{
		Pods:             make(map[string]*corev1.Pod),
		Services:         make(map[string]*corev1.Service),
		PVCs:             make(map[string]*corev1.PersistentVolumeClaim),
		StateChangeDelay: 10 * time.Millisecond, // 减少默认延迟提高测试速度
		EventRecords:     make([]EventRecord, 0),
	}
}

// 实现kubernetes.Interface接口的核心方法

func (m *MockK8sClient) CoreV1() corev1typed.CoreV1Interface {
	return &mockCoreV1Client{mock: m}
}

func (m *MockK8sClient) Discovery() discovery.DiscoveryInterface {
	return &mockDiscoveryClient{}
}

func (m *MockK8sClient) AppsV1() appsv1.AppsV1Interface {
	return &mockAppsV1Client{mock: m}
}

// 模拟Pod操作
func (m *MockK8sClient) CreatePod(ctx context.Context, namespace string, pod *corev1.Pod) error {
	if m.CreatePodFail {
		return fmt.Errorf("mock pod creation failed")
	}

	m.mu.Lock()
	defer m.mu.Unlock()

	key := fmt.Sprintf("%s/%s", namespace, pod.Name)

	// 模拟状态转换延迟
	if m.StateChangeDelay > 0 {
		time.Sleep(m.StateChangeDelay)
	}

	// 创建Pod副本
	podCopy := pod.DeepCopy()
	podCopy.Status.Phase = corev1.PodPending
	podCopy.Status.PodIP = "10.244.0.100" // 模拟IP

	m.Pods[key] = podCopy

	// 模拟Pod状态变化（从Pending到Running）
	go m.simulatePodStateChange(key)

	return nil
}

func (m *MockK8sClient) DeletePod(ctx context.Context, namespace, name string) error {
	if m.DeletePodFail {
		return fmt.Errorf("mock pod deletion failed")
	}

	m.mu.Lock()
	defer m.mu.Unlock()

	key := fmt.Sprintf("%s/%s", namespace, name)
	if _, exists := m.Pods[key]; !exists {
		return fmt.Errorf("pod not found")
	}

	delete(m.Pods, key)
	return nil
}

func (m *MockK8sClient) GetPod(ctx context.Context, namespace, name string) (*corev1.Pod, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()

	key := fmt.Sprintf("%s/%s", namespace, name)
	pod, exists := m.Pods[key]
	if !exists {
		return nil, fmt.Errorf("pod not found")
	}
	return pod.DeepCopy(), nil
}

func (m *MockK8sClient) ListPods(ctx context.Context, namespace string, opts metav1.ListOptions) (*corev1.PodList, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()

	var pods []corev1.Pod
	for key, pod := range m.Pods {
		// 简单的namespace过滤
		if namespace == "" || key[:len(namespace)] == namespace {
			pods = append(pods, *pod.DeepCopy())
		}
	}

	return &corev1.PodList{
		Items: pods,
	}, nil
}

// 模拟Service操作
func (m *MockK8sClient) CreateService(ctx context.Context, namespace string, svc *corev1.Service) error {
	if m.CreateServiceFail {
		return fmt.Errorf("mock service creation failed")
	}

	m.mu.Lock()
	defer m.mu.Unlock()

	key := fmt.Sprintf("%s/%s", namespace, svc.Name)
	m.Services[key] = svc.DeepCopy()
	return nil
}

func (m *MockK8sClient) GetService(ctx context.Context, namespace, name string) (*corev1.Service, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()

	key := fmt.Sprintf("%s/%s", namespace, name)
	svc, exists := m.Services[key]
	if !exists {
		return nil, fmt.Errorf("service not found")
	}
	return svc.DeepCopy(), nil
}

// 模拟PVC操作
func (m *MockK8sClient) CreatePVC(ctx context.Context, pvc *corev1.PersistentVolumeClaim) error {
	if m.CreatePVCFail {
		return fmt.Errorf("mock pvc creation failed")
	}

	m.mu.Lock()
	defer m.mu.Unlock()

	key := fmt.Sprintf("%s/%s", pvc.Namespace, pvc.Name)
	m.PVCs[key] = pvc.DeepCopy()
	return nil
}

func (m *MockK8sClient) DeletePVC(ctx context.Context, namespace, name string) error {
	m.mu.Lock()
	defer m.mu.Unlock()

	key := fmt.Sprintf("%s/%s", namespace, name)
	delete(m.PVCs, key)
	return nil
}

// simulatePodStateChange 模拟Pod状态变化
func (m *MockK8sClient) simulatePodStateChange(podKey string) {
	time.Sleep(m.StateChangeDelay)

	m.mu.Lock()
	defer m.mu.Unlock()

	if pod, exists := m.Pods[podKey]; exists {
		pod.Status.Phase = corev1.PodRunning
		pod.Status.PodIPs = []corev1.PodIP{
			{IP: pod.Status.PodIP},
		}
		pod.Status.Conditions = []corev1.PodCondition{
			{
				Type:   corev1.PodReady,
				Status: corev1.ConditionTrue,
			},
		}
	}
}

// RecordEvent 记录事件
func (m *MockK8sClient) RecordEvent(eventType, reason, message string) {
	m.mu.Lock()
	defer m.mu.Unlock()

	m.EventRecords = append(m.EventRecords, EventRecord{
		EventType: eventType,
		Reason:    reason,
		Message:   message,
		Timestamp: time.Now(),
	})
}

// GetEventRecords 获取事件记录
func (m *MockK8sClient) GetEventRecords() []EventRecord {
	m.mu.RLock()
	defer m.mu.RUnlock()

	records := make([]EventRecord, len(m.EventRecords))
	copy(records, m.EventRecords)
	return records
}

// ClearEventRecords 清除事件记录
func (m *MockK8sClient) ClearEventRecords() {
	m.mu.Lock()
	defer m.mu.Unlock()

	m.EventRecords = make([]EventRecord, 0)
}

// GetPodState 获取Pod状态统计
func (m *MockK8sClient) GetPodState() (running, pending int) {
	m.mu.RLock()
	defer m.mu.RUnlock()

	for _, pod := range m.Pods {
		switch pod.Status.Phase {
		case corev1.PodRunning:
			running++
		case corev1.PodPending:
			pending++
		}
	}
	return
}

// SetPodState 手动设置Pod状态（用于测试场景）
func (m *MockK8sClient) SetPodState(namespace, name string, phase corev1.PodPhase) {
	m.mu.Lock()
	defer m.mu.Unlock()

	key := fmt.Sprintf("%s/%s", namespace, name)
	if pod, exists := m.Pods[key]; exists {
		pod.Status.Phase = phase
		if phase == corev1.PodRunning {
			pod.Status.PodIP = "10.244.0.100"
			pod.Status.Conditions = []corev1.PodCondition{
				{
					Type:   corev1.PodReady,
					Status: corev1.ConditionTrue,
				},
			}
		}
	}
}

