	mock      *MockK8sClient
	namespace string
}

func (m *mockPodInterface) Create(ctx context.Context, pod *corev1.Pod, opts metav1.CreateOptions) (*corev1.Pod, error) {
	err := m.mock.CreatePod(ctx, m.namespace, pod)
	if err != nil {
		return nil, err
	}
	return m.mock.GetPod(ctx, m.namespace, pod.Name)
}

